LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
PINECONE_API_KEY=

# Limited app_user role, created by `python -m db.create_app_user`
DATABASE_URL=
# Owner role, used only by db.setup and db.create_app_user
ADMIN_DATABASE_URL=
# Same two roles on the Neon test branch, for integration tests
TEST_DATABASE_URL=
TEST_ADMIN_DATABASE_URL=

# Optional
HUMAN_TRANSFER_NUMBER=     # E.164, e.g. +15551234567; phone calls only
PINECONE_INDEX_NAME=       # default: nexaconnect-kb
PINECONE_NAMESPACE=        # default: production
AGENT_NAME=                # default: nexaconnect-ashley
BUSINESS_TIMEZONE=         # default: America/New_York
